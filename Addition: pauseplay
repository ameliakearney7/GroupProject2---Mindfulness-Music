import pygame
import sys
import os
import random

pygame.init()
pygame.mixer.init()

# ── Screen ───────────────────────────────────────────────────────────────────
screen_width  = 800
screen_height = 650   # slightly taller to fit the button
screen = pygame.display.set_mode((screen_width, screen_height))
pygame.display.set_caption("Mood Player")

BLACK      = (0,   0,   0)
WHITE      = (255, 255, 255)
DARK_GREY  = (60,  60,  60)
MID_GREY   = (120, 120, 120)
LIGHT_GREY = (210, 210, 210)

# ── Song folders (update paths here if needed) ───────────────────────────────
FOLDERS = {
    "angry":     "/home/lick/Downloads/Pi Songs/Amelia (34 - happy, angry, 4 of sad)/Angry",
    "nostalgic": "/home/lick/Downloads/Pi Songs/Aaliyah_ Sad, Nostalgic, calm/Nostalgic",
    "happy":     "/home/lick/Downloads/Pi Songs/Amelia (34 - happy, angry, 4 of sad)/happy",
    "sad":       "/home/lick/Downloads/Pi Songs/Aaliyah_ Sad, Nostalgic, calm/Sad",
    "in love":   "/home/lick/Downloads/Pi Songs/Julia_ sleepy, bored, confident, in love, excited-grwm/In Love",
    "bored":     "/home/lick/Downloads/Pi Songs/Julia_ sleepy, bored, confident, in love, excited-grwm/Bored",
}

def get_random_song(emotion):
    """Return a random mp3/wav file path from the emotion's folder, or None."""
    folder = FOLDERS.get(emotion, "")
    if not os.path.isdir(folder):
        print(f"Folder not found: {folder}")
        return None
    songs = [f for f in os.listdir(folder) if f.lower().endswith((".mp3", ".wav", ".ogg"))]
    if not songs:
        print(f"No songs found in: {folder}")
        return None
    return os.path.join(folder, random.choice(songs))

def play_song(emotion):
    """Stop whatever is playing and start a random song for the emotion."""
    global is_paused
    pygame.mixer.music.stop()
    song = get_random_song(emotion)
    if song:
        pygame.mixer.music.load(song)
        pygame.mixer.music.play()
        is_paused = False
        print(f"Now playing ({emotion}): {os.path.basename(song)}")

# ── Circle / button layout ───────────────────────────────────────────────────
CIRCLES_DATA = [
    ("angry",     (255, 0,   0)),    # Red
    ("nostalgic", (255, 125, 0)),    # Orange
    ("happy",     (255, 255, 0)),    # Yellow
    ("sad",       (0,   0,   255)),  # Blue
    ("in love",   (255, 182, 193)),  # Pink
    ("bored",     (169, 169, 169)),  # Grey
]

circle_radius = 70
cols, rows = 3, 2

# Push circles up a bit so the button fits below
h_spacing = screen_width  // (cols + 1)
v_spacing = (screen_height - 100) // (rows + 1)   # reserve 100 px at bottom

circles = []
for i, (emotion, color) in enumerate(CIRCLES_DATA):
    x = h_spacing * (i % cols + 1)
    y = v_spacing * (i // cols + 1)
    circles.append((x, y, color, emotion))

font       = pygame.font.SysFont(None, 30, bold=True)
font_small = pygame.font.SysFont(None, 22)

now_playing = ""
is_paused   = False   # track pause state

# ── Pause / Play button ──────────────────────────────────────────────────────
btn_w, btn_h   = 140, 44
btn_x = screen_width  // 2 - btn_w // 2
btn_y = screen_height - 60          # near the very bottom
btn_rect = pygame.Rect(btn_x, btn_y, btn_w, btn_h)
btn_radius = 22                      # rounded corners

def draw_rounded_rect(surface, color, rect, radius):
    pygame.draw.rect(surface, color, rect, border_radius=radius)

def draw_pause_play_button(mouse_pos):
    """Draw the pause/play button and its icon."""
    hovered = btn_rect.collidepoint(mouse_pos)
    has_song = bool(now_playing)

    # Button colours
    if not has_song:
        bg_color   = LIGHT_GREY
        icon_color = MID_GREY
    elif hovered:
        bg_color   = DARK_GREY
        icon_color = WHITE
    else:
        bg_color   = (50, 50, 50)
        icon_color = WHITE

    draw_rounded_rect(screen, bg_color, btn_rect, btn_radius)

    cx = btn_rect.centerx
    cy = btn_rect.centery
    icon_size = 14   # half-height of icon

    if is_paused:
        # ▶  Play triangle (pointing right)
        pts = [
            (cx - 8, cy - icon_size),
            (cx - 8, cy + icon_size),
            (cx + 10, cy),
        ]
        pygame.draw.polygon(screen, icon_color, pts)
        label = font_small.render("play", True, icon_color)
    else:
        # ❚❚  Pause — two vertical bars
        bar_w, bar_h = 6, icon_size * 2
        pygame.draw.rect(screen, icon_color,
                         (cx - 13, cy - icon_size, bar_w, bar_h))
        pygame.draw.rect(screen, icon_color,
                         (cx + 4,  cy - icon_size, bar_w, bar_h))
        label = font_small.render("pause", True, icon_color)

    # Text label to the right of the icon
    screen.blit(label, label.get_rect(midleft=(cx + 22, cy)))


def handle_pause_play():
    """Toggle pause/resume. Does nothing if nothing has been loaded yet."""
    global is_paused
    if not now_playing:
        return
    if is_paused:
        pygame.mixer.music.unpause()
        is_paused = False
    else:
        pygame.mixer.music.pause()
        is_paused = True


def draw_circles(mouse_pos):
    for (x, y, color, emotion) in circles:
        hovered = (x - mouse_pos[0])**2 + (y - mouse_pos[1])**2 <= circle_radius**2

        draw_color = tuple(min(255, c + 40) for c in color) if hovered else color
        pygame.draw.circle(screen, draw_color, (x, y), circle_radius)
        pygame.draw.circle(screen, BLACK, (x, y), circle_radius, 2)

        words = emotion.split()
        if len(words) == 1:
            label = font.render(words[0], True, BLACK)
            screen.blit(label, label.get_rect(center=(x, y)))
        else:
            for j, word in enumerate(words):
                line_y = y - (len(words) - 1) * 10 + j * 20
                label = font.render(word, True, BLACK)
                screen.blit(label, label.get_rect(center=(x, line_y)))


# ── Main loop ────────────────────────────────────────────────────────────────
running = True
while running:
    mouse_pos = pygame.mouse.get_pos()

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            # Check pause/play button first
            if btn_rect.collidepoint(event.pos):
                handle_pause_play()
            else:
                # Check mood circles
                for (x, y, color, emotion) in circles:
                    if (x - event.pos[0])**2 + (y - event.pos[1])**2 <= circle_radius**2:
                        play_song(emotion)
                        now_playing = emotion
                        break

    screen.fill(WHITE)
    draw_circles(mouse_pos)

    # Now-playing label just above the button
    if now_playing:
        state_tag = " (paused)" if is_paused else ""
        status = font_small.render(
            f"now playing: {now_playing}{state_tag}", True, (80, 80, 80)
        )
        screen.blit(status, status.get_rect(center=(screen_width // 2, btn_y - 18)))

    draw_pause_play_button(mouse_pos)

    pygame.display.flip()

pygame.mixer.music.stop()
pygame.quit()
sys.exit()
